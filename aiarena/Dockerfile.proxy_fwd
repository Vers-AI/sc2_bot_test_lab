# Extends the stock bot controller for compiled (C++, Go, .NET) bots:
# extra system libraries plus the SC2API protocol shim (protocol_shim.py)
# that bridges Churchill-era ladder clients to the aiarena proxy.

FROM aiarena/arenaclient-bot:v0.8.0

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends socat \
    && rm -rf /var/lib/apt/lists/*

COPY entrypoint_proxy_fwd.sh /entrypoint_proxy_fwd.sh
COPY protocol_shim.py /shim/protocol_shim.py
RUN chmod +x /entrypoint_proxy_fwd.sh

ENTRYPOINT ["/entrypoint_proxy_fwd.sh"]
